QA_MODEL_MODE=demo
# QA_MODEL_MODE=llm
# QA_LLM_BASE_URL=https://openrouter.ai/api/v1
# QA_LLM_API_KEY=replace_me
# QA_LLM_MODEL=provider/model-id

# Optional learned semantic embeddings; demo mode is offline lexical hashing.
QA_EMBEDDING_MODE=demo
QA_EMBEDDING_BASE_URL=
QA_EMBEDDING_API_KEY=
QA_EMBEDDING_MODEL=

# Release-only reviewer credential; no deployment permission.
QA_RELEASE_REVIEWER=local-reviewer
QA_RELEASE_REVIEW_TOKEN=YOUR_LOCAL_32_CHARACTER_OR_LONGER_SECRET

# Local development defaults. Docker reads private .secrets instead of this file.
QA_DEPLOYMENT_MODE=local
QA_EXECUTION_MODE=local
# QA_DATABASE_URL=postgresql://qa:private_password@localhost:5432/qa
# QA_CHROMA_HOST=localhost
# QA_CHROMA_PORT=8000
# Raw graph tracing stays disabled. Optional exporter sends sanitized metadata only.
LANGSMITH_TRACING=false
QA_LANGSMITH_ENABLED=false
LANGSMITH_PROJECT=agentic-qa-metadata
# LANGSMITH_API_KEY_FILE=/run/secrets/langsmith_api_key
