pid /tmp/nginx.pid;
events { worker_connections 1024; }
http {
 include /etc/nginx/mime.types;
 default_type application/octet-stream;
 access_log off;
 error_log /dev/stderr warn;
 client_body_temp_path /tmp/client_temp;
 proxy_temp_path /tmp/proxy_temp;
 fastcgi_temp_path /tmp/fastcgi_temp;
 uwsgi_temp_path /tmp/uwsgi_temp;
 scgi_temp_path /tmp/scgi_temp;
 server {
  listen 8080;
  server_tokens off;
  client_max_body_size 1m;
  auth_basic "Agentic QA controlled demo";
  auth_basic_user_file /run/secrets/demo_htpasswd;
  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;
  add_header Referrer-Policy no-referrer always;
  location = /healthz { auth_basic off; return 200 'ok'; }
  location /api/ {
   proxy_pass http://backend:8001/;
   proxy_set_header X-QA-Access-Token "${QA_PROXY_TOKEN}";
   # Reviewer Bearer is forwarded independently of the demo Basic login.
   proxy_set_header Authorization $http_x_qa_reviewer;
   proxy_read_timeout 120s;
  }
  location / { root /usr/share/nginx/html; try_files $uri $uri/ /index.html; }
 }
}
